<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:MatchmakingLab.ViewModels" mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650" x:Class="MatchmakingLab.Views.MainView" x:DataType="vm:MainViewModel">
  <ScrollViewer><StackPanel Margin="28" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">
    <TextBlock Text="Matchmaking Lab" FontSize="30" FontWeight="Bold"/><TextBlock Text="Pare jogadores por MMR, região e ping; aplique Elo ao resultado." Opacity="0.75"/>
    <Border Padding="16" CornerRadius="8" Background="#F1F5F9"><StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Faixa MMR" VerticalAlignment="Center"/><NumericUpDown Value="{Binding MaxDifference}" Minimum="0" Maximum="1000" Increment="10" Width="100"/><TextBlock Text="Ping máx. (ms)" VerticalAlignment="Center"/><NumericUpDown Value="{Binding MaxPing}" Minimum="1" Maximum="500" Increment="10" Width="100"/></StackPanel><Button Content="Buscar partidas" Command="{Binding FindMatchesCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <TextBlock Text="Fila de 6 jogadores: 3 em SA · 3 em EU" Opacity="0.7"/><Border Padding="16" CornerRadius="8" Background="#DBEAFE"><TextBlock Text="{Binding Results}" FontFamily="monospace" TextWrapping="Wrap"/></Border>
    <StackPanel Orientation="Horizontal" Spacing="10"><ComboBox ItemsSource="{Binding WinnerChoices}" SelectedItem="{Binding WinnerChoice}" Width="140"/><Button Content="Registrar resultado do 1º par" Command="{Binding ApplyFirstMatchResultCommand}"/></StackPanel><TextBlock Text="{Binding RatingResult}"/>
  </StackPanel></ScrollViewer>
</UserControl>
